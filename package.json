{
  "name": "almacenes-agbc",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma institucional AGBC: Activos, Almacenes y Conciliaciones",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node tests/server-start.mjs && node tests/auth-server-security.mjs && node tests/secure-action-backup.mjs && node --experimental-vm-modules tests/warehouse-security.mjs && tsx tests/csv-export.ts && tsx tests/report-pdf.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "3.3.0",
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.0",
    "admin-lte": "^4.10.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "2.6.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.7",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.0",
    "eslint-config-next": "16.4.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
