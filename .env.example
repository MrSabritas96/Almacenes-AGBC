# ── App ──────────────────────────────
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────
# Cada desarrollador usa SU PROPIA base local (no compartir).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/Almacenes-AGBC
DB_POOL_MAX=10

# ── Better Auth ──────────────────────
# Generar: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# ── Seed (superadmin inicial) ────────
SEED_ADMIN_EMAIL=admin@agbc.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Administrador

# ── SMTP (Zimbra / Postfix / Gmail) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Almacenes AGBC <no-reply@example.com>"
SMTP_REJECT_UNAUTHORIZED=true

# ── Respaldos ────────────────────────
BACKUP_DIR=./backups

# Cuentas iniciales de almacenes (definir contraseñas antes de db:seed)
SEED_WAREHOUSE_EMAIL=almacen@agbc.local
SEED_WAREHOUSE_PASSWORD=

SEED_ADMIN_USERNAME=admin
SEED_WAREHOUSE_USERNAME=almacen

# Docker Compose: obligatorio; codificar caracteres reservados para DATABASE_URL.
POSTGRES_PASSWORD=
